# Names only. Copy to .env (git-ignored) or local.properties and fill in values locally.
# The app reads these at build time. Process environment variables win over files.

# --- Compiled into the app (safe to ship: public/publishable values) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_WEB_CLIENT_ID=
SUPPORT_EMAIL=

# --- Developer machine / CI only (NEVER put these in the app or commit them) ---
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# The Supabase service-role key must never be added to this project.
